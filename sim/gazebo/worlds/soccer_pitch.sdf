<?xml version="1.0"?>
<!--
  Pitch is SoccerPitchConfiguration scaled by 0.15: 18 m x 10.5 m.
  Line positions match the 120 m x 70 m template, so a homography onto it is consistent.
-->
<sdf version="1.8">
  <world name="soccer_pitch">
    <physics name="pitch_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.72 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0.5 0.3</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.3 0.15 -0.9</direction>
    </light>

    <include>
      <uri>model://robocup_3Dsim_field</uri>
      <name>pitch</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://robocup_3Dsim_ball</uri>
      <name>ball</name>
      <pose>0 0 0.05 0 0 0</pose>
      <scale>0.6 0.6 0.6</scale>
    </include>
    <!-- PLAYERS_BEGIN -->
    <include>
      <uri>model://sim_red_1</uri>
      <name>sim_red_1</name>
    </include>
    <include>
      <uri>model://sim_red_4</uri>
      <name>sim_red_4</name>
    </include>
    <include>
      <uri>model://sim_red_5</uri>
      <name>sim_red_5</name>
    </include>
    <include>
      <uri>model://sim_red_7</uri>
      <name>sim_red_7</name>
    </include>
    <include>
      <uri>model://sim_red_9</uri>
      <name>sim_red_9</name>
    </include>
    <include>
      <uri>model://sim_red_10</uri>
      <name>sim_red_10</name>
    </include>
    <include>
      <uri>model://sim_blue_1</uri>
      <name>sim_blue_1</name>
    </include>
    <include>
      <uri>model://sim_blue_3</uri>
      <name>sim_blue_3</name>
    </include>
    <include>
      <uri>model://sim_blue_6</uri>
      <name>sim_blue_6</name>
    </include>
    <include>
      <uri>model://sim_blue_8</uri>
      <name>sim_blue_8</name>
    </include>
    <include>
      <uri>model://sim_blue_11</uri>
      <name>sim_blue_11</name>
    </include>
    <!-- PLAYERS_END -->

    <!-- Shared deck under both cameras. No poles. -->
    <model name="camera_platform">
      <static>true</static>
      <pose>1.1 -13 7.52 0 0 0</pose>
      <link name="link">
        <visual name="deck">
          <geometry><box><size>3.8 1.5 0.16</size></box></geometry>
          <material>
            <ambient>0.22 0.24 0.28 1</ambient>
            <diffuse>0.22 0.24 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sideline view matching data/gazebo2.png. Image topic: /pitch_camera -->
    <model name="pitch_camera">
      <static>true</static>
      <pose>0 -13 8 0 0.55 1.5707963</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>1.2 0.7 0.7</size></box></geometry>
          <material>
            <ambient>0.95 0.75 0.05 1</ambient>
            <diffuse>0.95 0.75 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="lens">
          <pose>0.8 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="camera" type="camera">
          <!-- In front of the lens. The body occupies x < 1.15. -->
          <pose>1.3 0 0 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <topic>/pitch_camera</topic>
          <camera>
            <horizontal_fov>1.25</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.2</near>
              <far>80</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Yaw motor stays level and only yaws. The camera pitches inside the fork. -->
    <model name="tele_yaw">
      <static>false</static>
      <pose>2.2 -13 8 0 0 1.5707963</pose>
      <link name="link">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia>
        </inertial>
        <visual name="yaw_motor">
          <pose>0 0 -0.28 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.2</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.15 0.16 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="fork_l">
          <pose>0.02 0.28 0.02 0 0 0</pose>
          <geometry><box><size>0.12 0.08 0.42</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
        <visual name="fork_r">
          <pose>0.02 -0.28 0.02 0 0 0</pose>
          <geometry><box><size>0.12 0.08 0.42</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tele_camera">
      <static>false</static>
      <pose>2.2 -13 8 0 0.55 1.5707963</pose>
      <link name="link">
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
          </inertia>
        </inertial>
        <visual name="pitch_motor">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.45 0.75 1</ambient>
            <diffuse>0.12 0.45 0.75 1</diffuse>
          </material>
        </visual>
        <visual name="body">
          <pose>0.45 0 0 0 0 0</pose>
          <geometry><box><size>0.7 0.28 0.28</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>
        <visual name="lens">
          <pose>1.15 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.6</length></cylinder></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>2.05 0 0 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <topic>/tele_camera</topic>
          <camera>
            <horizontal_fov>0.32</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.15</near>
              <far>80</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
